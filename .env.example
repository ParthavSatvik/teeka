# Copy to .env and fill in. Never commit .env.

# Needed on a public host, so strangers cannot spend your credits. Leave empty on your own laptop.
ACCESS_CODE=

# Leave GNANI_API_KEY empty to run in mock mode (typed replies, no audio).
GNANI_API_KEY=

# stream = Prisma realtime WebSocket, rest = transcribe each recorded reply
STT_MODE=stream
# prisma-v2.5 (default) or prisma-v3.0
STT_MODEL=prisma-v2.5
# timbre-v2.5 (per-language voices) or timbre-v3.0 (one voice pair for every language)
TTS_MODEL=timbre-v2.5

# Optional: path to your own 5-30 second voice recording, for the cloned family teacher
FAMILY_VOICE_FILE=

# Seconds to wait for a reply before the caller moves on
LISTEN_MAX_S=9
# Prisma VAD (docs: 0.0-1.0; noisy room ~0.7)
VAD_THRESHOLD=0.6
# Prisma VAD silence that ends a reply (docs: 100-2000 ms)
VAD_MIN_SILENCE_MS=600

# Fixed waits, in seconds. Lower is faster, but test with test_replies.py first.
# Wait after a transcript for the rest of the sentence
GRACE_S=0.8
# Keep the mic gate shut this long after the caller's voice ends
GATE_TAIL_S=0.5

# Optional: your own Gnani Evon server. Empty means the caller uses the written packs only.
EVON_URL=
